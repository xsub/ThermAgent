#!/usr/bin/env python3
"""ThermAgent Operator helper MVP.

This utility translates simple ThermAgent CR resources into local files consumed
by ThermAgent Edge. It does not write hardware controls directly.
"""
from __future__ import annotations

import argparse
import pathlib
import sys
import time
from typing import Any

POLICY_ORDER = [
    "name",
    "sample_interval_ms",
    "max_temp_c",
    "critical_temp_c",
    "thermal_hysteresis_c",
    "critical_hysteresis_c",
    "decision_hold_s",
    "missing_thermal_is_hot",
    "min_fps",
    "workload_stale_after_s",
    "idle_nvpmodel_mode",
    "active_nvpmodel_mode",
    "hot_nvpmodel_mode",
    "idle_cpu_governor",
    "active_cpu_governor",
    "hot_cpu_governor",
    "nvpmodel_bin",
    "workload_file",
    "prometheus_listen",
]


def load_resource(path: pathlib.Path) -> dict[str, Any]:
    if path.suffix == ".json":
        import json

        data = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            raise ValueError(f"{path}: expected JSON object")
        return data
    return parse_simple_yaml(path)


def parse_simple_yaml(path: pathlib.Path) -> dict[str, Any]:
    root: dict[str, Any] = {}
    stack: list[tuple[int, dict[str, Any]]] = [(-1, root)]
    for lineno, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        line = raw.split("#", 1)[0].rstrip()
        if not line.strip() or line.strip() == "---":
            continue
        if line.lstrip().startswith("-"):
            raise ValueError(f"{path}:{lineno}: list YAML is not supported by this helper")
        indent = len(line) - len(line.lstrip(" "))
        if ":" not in line:
            raise ValueError(f"{path}:{lineno}: expected key: value")
        key, value = line.strip().split(":", 1)
        while stack[-1][0] >= indent:
            stack.pop()
        parent = stack[-1][1]
        value = value.strip()
        if value:
            parent[key] = parse_scalar(value)
        else:
            child: dict[str, Any] = {}
            parent[key] = child
            stack.append((indent, child))
    return root


def parse_scalar(value: str) -> Any:
    value = value.strip()
    if len(value) >= 2 and value[0] == value[-1] and value[0] in {'"', "'"}:
        return value[1:-1]
    if value.lower() in {"true", "false"}:
        return value.lower() == "true"
    try:
        if "." in value:
            return float(value)
        return int(value)
    except ValueError:
        return value


def parse_policy(path: pathlib.Path) -> dict[str, str]:
    data: dict[str, str] = {}
    for lineno, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        line = raw.split("#", 1)[0].strip()
        if not line or line == "---":
            continue
        if ":" in line:
            key, value = line.split(":", 1)
        elif "=" in line:
            key, value = line.split("=", 1)
        else:
            raise ValueError(f"{path}:{lineno}: expected key: value")
        data[key.strip()] = value.strip()
    return data


def render_policy(policy: dict[str, str]) -> str:
    lines = [
        "# Generated by thermagent-operatorctl.",
        "# Local thermagentd safety validation remains authoritative.",
        "",
    ]
    for key in POLICY_ORDER:
        if key in policy:
            lines.append(f"{key}: {policy[key]}")
    for key in sorted(set(policy) - set(POLICY_ORDER)):
        lines.append(f"{key}: {policy[key]}")
    return "\n".join(lines) + "\n"


def apply_policy_resource(policy: dict[str, str], resource: dict[str, Any]) -> None:
    kind = resource.get("kind")
    spec = resource.get("spec", {})
    if not isinstance(spec, dict):
        raise ValueError(f"{kind}: spec must be an object")

    if kind == "ThermAgentPolicy":
        policy_ref = spec.get("policyRef", {})
        if isinstance(policy_ref, dict) and policy_ref.get("name"):
            policy["name"] = str(policy_ref["name"])
        safety = spec.get("safety", {})
        workload = spec.get("workload", {})
        if isinstance(safety, dict):
            if "maxTempC" in safety:
                policy["max_temp_c"] = str(safety["maxTempC"])
            if "criticalTempC" in safety:
                policy["critical_temp_c"] = str(safety["criticalTempC"])
        if isinstance(workload, dict) and "minFps" in workload:
            policy["min_fps"] = str(workload["minFps"])
    elif kind == "ThermalProfile":
        if "maxTempC" in spec:
            policy["max_temp_c"] = str(spec["maxTempC"])
        if "criticalTempC" in spec:
            policy["critical_temp_c"] = str(spec["criticalTempC"])
        if "hotCpuGovernor" in spec:
            policy["hot_cpu_governor"] = str(spec["hotCpuGovernor"])
        if "hotNvpmodelMode" in spec:
            policy["hot_nvpmodel_mode"] = str(spec["hotNvpmodelMode"])
    elif kind == "PowerBudget":
        mapping = {
            "idleNvpmodelMode": "idle_nvpmodel_mode",
            "activeNvpmodelMode": "active_nvpmodel_mode",
            "idleCpuGovernor": "idle_cpu_governor",
            "activeCpuGovernor": "active_cpu_governor",
        }
        for src, dst in mapping.items():
            if src in spec:
                policy[dst] = str(spec[src])
    else:
        raise ValueError(f"unsupported policy resource kind: {kind}")


def render_workload_hint(resource: dict[str, Any]) -> str:
    if resource.get("kind") != "WorkloadHint":
        raise ValueError("render-workload-hint expects kind: WorkloadHint")
    spec = resource.get("spec", {})
    if not isinstance(spec, dict):
        raise ValueError("WorkloadHint spec must be an object")
    busy = 1 if bool(spec.get("busy", False)) else 0
    fps = float(spec.get("fps", 0.0))
    phase = str(spec.get("phase", "unknown"))
    return "\n".join(
        [
            f"busy={busy}",
            f"fps={fps:.3f}",
            f"phase={phase}",
            f"updated_unix={int(time.time())}",
            "",
        ]
    )


def write_output(path: pathlib.Path | None, body: str) -> None:
    if path is None or str(path) == "-":
        print(body, end="")
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(body, encoding="utf-8")


def cmd_render_policy(args: argparse.Namespace) -> int:
    policy = parse_policy(args.base_policy)
    for resource_path in args.resource:
        apply_policy_resource(policy, load_resource(resource_path))
    write_output(args.output, render_policy(policy))
    return 0


def cmd_render_workload_hint(args: argparse.Namespace) -> int:
    write_output(args.output, render_workload_hint(load_resource(args.resource)))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="ThermAgent Operator resource translator")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("render-policy", help="render a thermagentd policy from ThermAgent resources")
    p.add_argument("--base-policy", type=pathlib.Path, required=True)
    p.add_argument("--resource", type=pathlib.Path, action="append", required=True)
    p.add_argument("--output", type=pathlib.Path)
    p.set_defaults(func=cmd_render_policy)

    p = sub.add_parser("render-workload-hint", help="render workload.metrics from WorkloadHint")
    p.add_argument("--resource", type=pathlib.Path, required=True)
    p.add_argument("--output", type=pathlib.Path)
    p.set_defaults(func=cmd_render_workload_hint)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    try:
        return int(args.func(args))
    except Exception as exc:  # noqa: BLE001 - CLI boundary
        print(f"thermagent-operatorctl: error: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())

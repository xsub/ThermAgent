# thermagentd PoC policy for Jetson Nano Lite / Jetson Nano-class boards.
# Format: one key-value per line. Both `key: value` and `key = value` are accepted.

name: jetson-nano-lite-safe-vision
sample_interval_ms: 1000

# Jetson Nano passive heatsink safety guard. Adjust after real thermal tests.
max_temp_c: 72.0
critical_temp_c: 78.0
thermal_hysteresis_c: 3.0
critical_hysteresis_c: 3.0
decision_hold_s: 5
missing_thermal_is_hot: true

# Vision workload target. Python tool writes fps into workload_file.
min_fps: 12.0
workload_stale_after_s: 15

# Jetson Nano convention: nvpmodel mode 0 is MAXN/10W, mode 1 is 5W.
idle_nvpmodel_mode: 1
active_nvpmodel_mode: 0
hot_nvpmodel_mode: 1

# schedutil is preferred when available; powersave is used for thermal guard.
idle_cpu_governor: schedutil
active_cpu_governor: schedutil
hot_cpu_governor: powersave

nvpmodel_bin: /usr/sbin/nvpmodel
workload_file: /run/thermagent/workload.metrics
prometheus_listen: 127.0.0.1:9920
